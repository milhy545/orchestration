#!/usr/bin/env python3
"""Read or disable Tailscale Funnel on the HAS host.

The command is intentionally limited to the host's existing Funnel setting.
It cannot enable Funnel, change listeners, or manage Docker.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from collections.abc import Sequence

DEFAULT_RUNNER = ("ssh", "HAS", "tailscale", "funnel")


def run_funnel(action: str, runner: Sequence[str] | None = None,
               execute=subprocess.run) -> str:
    """Run only ``tailscale funnel status --json`` or ``tailscale funnel off``.

    ``runner`` is injectable for tests and may be supplied by the
    ``MEGA_FUNNEL_RUNNER`` shell-word environment variable. The default targets
    the configured SSH alias ``HAS``.
    """
    if action not in {"status", "off"}:
        raise ValueError("only status and off are supported")
    base = tuple(runner or shlex.split(os.environ.get(
        "MEGA_FUNNEL_RUNNER", "ssh HAS tailscale funnel")))
    command = [*base, action]
    if action == "status":
        command.append("--json")
    try:
        completed = execute(command, check=False, capture_output=True, text=True)
    except OSError as exc:
        raise RuntimeError(f"cannot run Funnel command: {exc}") from exc
    if completed.returncode:
        detail = (completed.stderr or completed.stdout).strip()
        raise RuntimeError(detail or f"Funnel command exited {completed.returncode}")
    return completed.stdout.strip()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("status", "off"), nargs="?", default="status")
    parser.add_argument("--runner", help="test/maintenance runner command (shell words)")
    args = parser.parse_args(argv)
    try:
        output = run_funnel(args.action, shlex.split(args.runner) if args.runner else None)
        try:
            print(json.dumps(json.loads(output), indent=2, sort_keys=True, ensure_ascii=False))
        except json.JSONDecodeError:
            if output:
                print(output)
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
